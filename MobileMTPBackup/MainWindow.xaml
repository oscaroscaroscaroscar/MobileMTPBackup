<Window x:Class="MobileMTPBackup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mobile MTP Backup v5.6" Height="790" Width="980" MinHeight="700" MinWidth="850">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Mobile MTP Backup v5.6" FontSize="28" FontWeight="Bold"/><TextBlock Text="Backup av enstaka filer eller hela Android/MTP-mappar med originaldatum, EXIF-fallback och verifiering." Margin="0,6,0,18"/></StackPanel>
        <GroupBox Grid.Row="1" Header="Telefon / MTP-enhet" Margin="0,0,0,12"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="DeviceComboBox" Height="32" DisplayMemberPath="Name" VerticalContentAlignment="Center"/><Button Grid.Column="1" Content="Sök igen" Width="100" Margin="10,0,0,0" Click="RefreshDevices_Click"/><Button Grid.Column="2" Content="Läs mappar" Width="110" Margin="10,0,0,0" Click="LoadRoot_Click"/></Grid></GroupBox>
        <GroupBox Grid.Row="2" Header="Telefonens filer" Margin="0,0,0,12"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="185"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,8"><Button Content="Upp en nivå" Width="100" DockPanel.Dock="Left" Click="Up_Click"/><TextBlock x:Name="CurrentPathText" Text="\" VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="SemiBold"/></DockPanel><ListView Grid.Row="1" x:Name="EntriesList" MouseDoubleClick="EntriesList_MouseDoubleClick"><ListView.View><GridView><GridViewColumn Header="Typ" Width="70" DisplayMemberBinding="{Binding TypeText}"/><GridViewColumn Header="Namn" Width="410" DisplayMemberBinding="{Binding Name}"/><GridViewColumn Header="Storlek" Width="110" DisplayMemberBinding="{Binding SizeText}"/><GridViewColumn Header="Datum" Width="190" DisplayMemberBinding="{Binding DateText}"/></GridView></ListView.View></ListView></Grid></GroupBox>
        <GroupBox Grid.Row="3" Header="Backup-mål" Margin="0,0,0,12"><StackPanel Margin="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="DestinationTextBox" Height="32" Text="C:\MobilBackup" VerticalContentAlignment="Center"/><Button Grid.Column="1" Content="Välj mapp" Width="110" Margin="10,0,0,0" Click="ChooseFolder_Click"/></Grid><WrapPanel Margin="0,10,0,0"><CheckBox x:Name="PreserveDatesCheckBox" Content="Bevara originaldatum (MTP/EXIF)" IsChecked="True" Margin="0,0,20,0"/><CheckBox x:Name="VerifyCheckBox" Content="Verifiera SHA-256" IsChecked="True" Margin="0,0,20,0"/><CheckBox x:Name="IncrementalCheckBox" Content="Inkrementell backup" IsChecked="True"/></WrapPanel></StackPanel></GroupBox>
        <GroupBox Grid.Row="4" Header="Hel-mapp backup" Margin="0,0,0,12"><StackPanel Margin="12"><WrapPanel><Button x:Name="BackupFolderButton" Content="BACKUP HELA MAPPEN" Width="175" Height="38" FontWeight="Bold" Click="BackupFolder_Click"/><Button x:Name="PauseButton" Content="PAUS" Width="85" Height="38" Margin="10,0,0,0" IsEnabled="False" Click="Pause_Click"/><Button x:Name="ResumeButton" Content="FORTSÄTT" Width="95" Height="38" Margin="10,0,0,0" IsEnabled="False" Click="Resume_Click"/><Button x:Name="CancelButton" Content="AVBRYT" Width="95" Height="38" Margin="10,0,0,0" IsEnabled="False" Click="Cancel_Click"/><Button Content="BACKUP VALD FIL" Width="155" Height="38" Margin="10,0,0,0" Click="BackupSelected_Click"/><Button x:Name="AutoBackupButton" Content="AUTO BACKUP MEDIA" Width="165" Height="38" Margin="10,0,0,0" Click="AutoBackup_Click"/><Button x:Name="PreviewButton" Content="FÖRHANDSGRANSKA" Width="145" Height="38" Margin="10,0,0,0" Click="Preview_Click"/><Button Content="SYSTEMTEST" Width="110" Height="38" Margin="10,0,0,0" Click="SystemTest_Click"/></WrapPanel><ProgressBar x:Name="BackupProgressBar" Height="20" Minimum="0" Maximum="100" Margin="0,12,0,0"/><TextBlock x:Name="BackupStatusText" Text="Redo." Margin="0,5,0,0"/></StackPanel></GroupBox>
        <GroupBox Grid.Row="5" Header="Logg"><TextBox x:Name="LogTextBox" Margin="12" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/></GroupBox>
        <TextBlock Grid.Row="6" Margin="0,10,0,0" Text="Telefonens filer ändras eller raderas aldrig av backupfunktionen."/>
    </Grid>
</Window>
