<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MobileMTPBackup</AssemblyName>
    <RootNamespace>MobileMTPBackup</RootNamespace>
      <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishReadyToRun>false</PublishReadyToRun>
      <Version>4.6.0</Version>
    <AssemblyVersion>4.6.0.0</AssemblyVersion>
    <FileVersion>4.6.0.0</FileVersion>
      <PublishTrimmed>false</PublishTrimmed>
      <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <DebugType>embedded</DebugType>
</PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MediaDevices" Version="2.0.0" />
      <PackageReference Include="MetadataExtractor" Version="2.9.0" />
  </ItemGroup>
</Project>
